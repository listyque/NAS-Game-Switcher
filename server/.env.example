NGS_BIND_IP=0.0.0.0
NGS_PORT=8890
# Example: /volume1/Games and /volume1/Installers (read-only)
NGS_GAMES_PATH=./empty-games
NGS_INSTALLERS_PATH=./empty-installers

# Optional public HTTPS: domain only, no scheme/path. Keep blank until DNS is ready.
NGS_PUBLIC_DOMAIN=
NGS_HTTP_PORT=8088
NGS_HTTPS_PORT=8448
# Public mode: forward WAN 80 -> 8088 and WAN 443 -> 8448; never expose 8890/5432.
