#-- Start Entry --#
table = CreateTable('ngs_launcher/player_profile')
table.add('code',                     'varchar', length='160', not_null=True )
table.add('data',                     'text', not_null=True )
table.add('id',                       'serial', primary_key=True)
table.add_constraint(["code"], mode="UNIQUE")
