#-- Start Entry --#
table = CreateTable('ngs_launcher/package_job')
table.add('code',                     'varchar', length='80', not_null=True )
table.add('description',              'text' )
table.add('game_id',                  'varchar', length='80' )
table.add('id',                       'serial', primary_key=True)
table.add('published_data',           'text' )
table.add('s_status',                 'varchar', length='32' )
table.add('state',                    'varchar', length='16' )
table.add('timestamp',                'timestamp' )
table.add_constraint(["code"], mode="UNIQUE")
#-- End Entry --#

