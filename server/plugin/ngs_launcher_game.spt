#-- Start Entry --#
table = CreateTable('ngs_launcher/game')
table.add('accent',                   'varchar', length='7' )
table.add('available_on_nas',         'boolean' )
table.add('background_snapshot',      'varchar', length='256' )
table.add('code',                     'varchar', length='256' )
table.add('cover_snapshot',           'varchar', length='256' )
table.add('description',              'text' )
table.add('executable',               'text' )
table.add('genre',                    'text' )
table.add('id',                       'serial', primary_key=True)
table.add('import_state',             'text' )
table.add('metadata_url',             'text' )
table.add('name',                     'varchar', length='256' )
table.add('published_data',           'text' )
table.add('revision',                 'integer' )
table.add('s_status',                 'varchar', length='32' )
table.add('source_folder',            'text' )
table.add('status',                   'varchar', length='32' )
table.add('subtitle',                 'text' )
table.add('timestamp',                'timestamp' )
table.add_constraint(["code"], mode="UNIQUE")
#-- End Entry --#

