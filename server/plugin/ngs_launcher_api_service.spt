#-- Start Entry --#
table = CreateTable('ngs_launcher/api_service')
table.add('code',                     'varchar', length='32', not_null=True )
table.add('id',                       'serial', primary_key=True)
table.add('login',                    'varchar', length='64', not_null=True )
table.add('password',                 'varchar', length='128', not_null=True )
table.add_constraint(["code"], mode="UNIQUE")
#-- End Entry --#

