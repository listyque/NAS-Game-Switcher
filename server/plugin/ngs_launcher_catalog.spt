insert = SearchType.create('sthpw/search_object')
insert.set_value('class_name', """pyasm.search.SObject""")
insert.set_value('code', """ngs_launcher/catalog""")
insert.set_value('database', """{project}""")
insert.set_value('description', """NGS catalog schema v1""")
insert.set_value('namespace', """ngs_launcher""")
insert.set_value('schema', """public""")
insert.set_value('search_type', """ngs_launcher/catalog""")
