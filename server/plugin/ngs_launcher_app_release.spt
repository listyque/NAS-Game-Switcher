#-- Start Entry --#
table = CreateTable('ngs_launcher/app_release')
table.add('code',                     'varchar', length='64', not_null=True )
table.add('description',              'text' )
table.add('id',                       'serial', primary_key=True)
table.add('name',                     'varchar', length='256' )
table.add('published_data',           'text', not_null=True )
table.add('s_status',                 'varchar', length='32' )
table.add('timestamp',                'timestamp' )
table.add_constraint(["code"], mode="UNIQUE")
#-- End Entry --#

