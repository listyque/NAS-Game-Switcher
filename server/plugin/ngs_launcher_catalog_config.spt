#-- Start Entry --#
table = CreateTable('ngs_launcher/catalog_config')
table.add('code',                     'varchar', length='64', not_null=True )
table.add('data',                     'text', not_null=True )
table.add('description',              'text', not_null=True )
table.add('id',                       'serial', primary_key=True)
table.add_constraint(["code"], mode="UNIQUE")
